# agy-gateway configuration. Every variable is optional; the values below are
# the defaults unless marked "example". See README.md for details.

# Public OpenAI-compatible API.
AGY_GW_LISTEN=:8080
# Bearer keys the API accepts, comma-separated (example). Empty accepts any
# caller, which is only sensible on a private network.
AGY_GW_API_KEYS=change-me-1,change-me-2

# Official runtime. The container image sets RUNTIME_CMD to
# /opt/agy/agy_acp_server.par and RUNTIME_HOME to /data.
AGY_GW_RUNTIME_CMD=agy_acp_server.par
AGY_GW_RUNTIME_ARGS=--uid=
# HOME for the runtime; its state (sign-in, conversations) is
# $AGY_GW_RUNTIME_HOME/.gemini/antigravity-acp. Empty keeps $HOME.
AGY_GW_RUNTIME_HOME=
# One empty directory per runtime session is created here.
AGY_GW_WORKDIR=/tmp/agy-gateway

# Optional, off by default: patch a copy of localharness_external before the
# runtime starts, for example with a context-window unlock. The copy's path is
# appended as the last argument; the original is never written. See README.md.
# AGY_GW_HARNESS_PATCH_CMD=python3 /opt/agy-patch/agy-patch.py --in-place --no-backup --binary
# Use this harness instead of the one next to the runtime (example).
# AGY_GW_HARNESS_PATH=/opt/agy-patched/localharness_external
# Patched copies; defaults to $AGY_GW_RUNTIME_HOME/.cache/agy-gateway/harness.
# AGY_GW_HARNESS_CACHE_DIR=

# Loopback MCP tool bridge that only the runtime calls. Port 0 picks a port.
AGY_GW_BRIDGE_LISTEN=127.0.0.1:0
# MCP server name the runtime sees; tools appear to the model as <name>_<tool>.
AGY_GW_MCP_SERVER_NAME=client

# Sessions.
AGY_GW_SESSION_TTL=30m
AGY_GW_MAX_SESSIONS=64
# How long a tool call waits for the client's result. Must stay below the
# runtime's 180s MCP call limit.
AGY_GW_TOOL_RESULT_TIMEOUT=170s
# Upper bound for one HTTP request.
AGY_GW_REQUEST_TIMEOUT=15m
# How long to wait for further tool calls before answering with a batch.
AGY_GW_TOOL_BATCH_WINDOW=250ms
# Bytes of transcript replayed when a runtime session was lost.
AGY_GW_REPLAY_BUDGET=163840
# Tool schemas larger than this many bytes lose nested documentation keys.
AGY_GW_SCHEMA_BUDGET=1350

# Accept and ignore temperature, top_p, max_tokens, stop, seed and penalties
# instead of answering 400. Most coding clients send them.
AGY_GW_IGNORE_UNSUPPORTED_PARAMS=false
# Stream runtime thoughts as reasoning_content.
AGY_GW_EMIT_REASONING=true
# debug, info, warn or error. Logs never contain credentials or prompts.
AGY_GW_LOG_LEVEL=info
